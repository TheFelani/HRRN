import threading
import time

class Process:
    def __init__(self, pid, arrival_time, burst_time):
        self.pid = pid
        self.arrival_time = arrival_time
        self.burst_time = burst_time
        self.waiting_time = 0
        self.turnaround_time = 0
        self.completed = False

class HRRNSemaphoreScheduler:
    def __init__(self):
        self.ready_queue = []
        self.mutex = threading.Semaphore(1)  # سمافور برای انحصار متقابل
        self.cpu_available = threading.Semaphore(1) # کنترل دسترسی به CPU
        self.current_time = 0

    def add_process(self, p):
        self.mutex.acquire()
        self.ready_queue.append(p)
        self.mutex.release()

    def schedule(self):
        global finished_count
        finished_count = 0
        total_processes = len(self.ready_queue)

        while finished_count < total_processes:
            self.mutex.acquire()
            # فیلتر کردن فرآیندهای رسیده و تمام‌نشده
            available = [p for p in self.ready_queue if p.arrival_time <= self.current_time and not p.completed]
            
            if not available:
                self.current_time += 1
                self.mutex.release()
                time.sleep(0.1)
                continue

            # محاسبه HRRN و انتخاب بهترین فرآیند
            best_process = None
            max_ratio = -1.0

            for p in available:
                p.waiting_time = self.current_time - p.arrival_time
                ratio = (p.waiting_time + p.burst_time) / p.burst_time
                if ratio > max_ratio:
                    max_ratio = ratio
                    best_process = p

            self.mutex.release()

            # اجرای فرآیند روی CPU (با محافظت سمافور)
            self.cpu_available.acquire()
            print(f"[Semaphore] Time {self.current_time}: Running Process {best_process.pid} (Ratio: {max_ratio:.2f})")
            time.sleep(best_process.burst_time * 0.1) # شبیه‌سازی زمان اجرا
            
            self.current_time += best_process.burst_time
            best_process.completed = True
            best_process.turnaround_time = self.current_time - best_process.arrival_time
            print(f"--> Process {best_process.pid} finished. Waiting Time: {best_process.waiting_time}")
            
            finished_count += 1
            self.cpu_available.release()

# تست کد
if __name__ == "__main__":
    scheduler = HRRNSemaphoreScheduler()
    scheduler.add_process(Process("P1", 0, 4))
    scheduler.add_process(Process("P2", 1, 3))
    scheduler.add_process(Process("P3", 2, 5))
    
    t = threading.Thread(target=scheduler.schedule)
    t.start()
    t.join()
